<workout_file>
    <author>OpenCycling</author>
    <name>Test Workout</name>
    <description>A test workout covering all block types</description>
    <sportType>bike</sportType>
    <workout>
        <Warmup Duration="600" PowerLow="0.25" PowerHigh="0.75"/>
        <SteadyState Duration="300" Power="0.85" name="Sweet Spot"/>
        <IntervalsT Repeat="4" OnDuration="60" OffDuration="120" OnPower="1.20" OffPower="0.50"/>
        <FreeRide Duration="180"/>
        <Cooldown Duration="300" PowerLow="0.75" PowerHigh="0.25"/>
    </workout>
</workout_file>