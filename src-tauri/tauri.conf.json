{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "opencycling",
  "version": "0.1.3",
  "identifier": "com.luka.opencycling.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "opencycling",
        "width": 1100,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY3QkM5QkI1NDI1NDBBNDkKUldSSkNsUkN0WnU4WjdJbEVpMTlkSldZNWpRdzd6K00yZWNOV252c1RWdDZnUUh2WlZTUzl1QXEK",
      "endpoints": [
        "https://github.com/TheElysium/opencycling/releases/latest/download/latest.json"
      ]
    }
  }
}
